{
  "name": "@weluvabid/iris",
  "version": "0.2.0",
  "description": "Pulse-style reusable site shell components for independent open-source projects.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "files": [
    "src/lib",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/lib/index.d.ts",
      "svelte": "./src/lib/index.js",
      "default": "./src/lib/index.js"
    },
    "./components": {
      "types": "./src/lib/index.d.ts",
      "svelte": "./src/lib/index.js",
      "default": "./src/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.svelte"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ./scripts/build.mjs",
    "check:types": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:pack": "node ./scripts/check-pack.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm check:types && pnpm test && pnpm build && pnpm check:pack",
    "prepare": "node ./scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.0.0",
    "eslint": "9.39.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.5.2",
    "shadcn-svelte": "^1.7.2",
    "svelte": "5.38.0",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.0.0",
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": false
    }
  },
  "dependencies": {
    "@icons-pack/svelte-simple-icons": "^7.2.0",
    "@lucide/svelte": "^1.66.0",
    "bits-ui": "^2.20.2",
    "cn": "^0.5.0",
    "tailwind-variants": "^3.3.1"
  }
}
