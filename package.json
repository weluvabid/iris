{
  "name": "@weluvabid/iris",
  "version": "0.4.0",
  "description": "Preconfigured Svelte 5 UI foundation with shadcn-svelte components, icons, data-table filters, theme tokens, and site-shell components.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "files": [
    "dist",
    "src/styles",
    "src/theme.js",
    "src/theme.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./src/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./theme.css": "./src/styles/theme.css",
    "./package.json": "./package.json",
    "./components/ui/*": {
      "types": "./dist/components/ui/*/index.d.ts",
      "svelte": "./dist/components/ui/*/index.js",
      "import": "./dist/components/ui/*/index.js",
      "default": "./dist/components/ui/*/index.js"
    },
    "./lucide": {
      "types": "./dist/icons/lucide.d.ts",
      "svelte": "./dist/icons/lucide.js",
      "import": "./dist/icons/lucide.js",
      "default": "./dist/icons/lucide.js"
    },
    "./simple-icons": {
      "types": "./dist/icons/simple-icons.d.ts",
      "svelte": "./dist/icons/simple-icons.js",
      "import": "./dist/icons/simple-icons.js",
      "default": "./dist/icons/simple-icons.js"
    },
    "./data-table": {
      "types": "./dist/data-table.d.ts",
      "svelte": "./dist/data-table.js",
      "import": "./dist/data-table.js",
      "default": "./dist/data-table.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "svelte": "./dist/hooks.js",
      "import": "./dist/hooks.js",
      "default": "./dist/hooks.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "svelte": "./dist/motion/index.js",
      "import": "./dist/motion/index.js",
      "default": "./dist/motion/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts --host 127.0.0.1",
    "build:demo": "vite build --config vite.demo.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm check:svelte && pnpm test && pnpm build && pnpm build:demo && pnpm check:consumer",
    "prepare": "node ./scripts/install-hooks.mjs",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "build": "svelte-package --input src/lib --output dist --tsconfig ./tsconfig.json",
    "check:consumer": "node ./scripts/check-consumer.mjs",
    "precommit": "pnpm lint && pnpm format:check && pnpm check:svelte && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.0.0",
    "eslint": "9.39.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.5.2",
    "shadcn-svelte": "^1.7.2",
    "svelte": "5.38.0",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": false
    }
  },
  "dependencies": {
    "@icons-pack/svelte-simple-icons": "^7.2.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.66.0",
    "@shadcn-svelte/primitives": "^0.0.1",
    "bits-ui": "^2.20.2",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.1.0",
    "layerchart": "^2.9.2",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "runed": "^0.38.0",
    "shiki": "^3.23.0",
    "svelte-sonner": "^1.2.2",
    "sveltekit-superforms": "^3.1.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul-svelte": "1.0.0-next.7"
  },
  "packageManager": "pnpm@12.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/weluvabid/iris.git"
  }
}
