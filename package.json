{
  "name": "@weluvabid/iris",
  "version": "0.2.1",
  "description": "Reusable Svelte site shell components with a Tailwind and shadcn-svelte theme.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "files": [
    "src/lib",
    "src/styles",
    "src/theme.js",
    "src/theme.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/lib/index.d.ts",
      "svelte": "./src/lib/index.js",
      "import": "./src/lib/index.js",
      "default": "./src/lib/index.js"
    },
    "./components": {
      "types": "./src/lib/index.d.ts",
      "svelte": "./src/lib/index.js",
      "import": "./src/lib/index.js",
      "default": "./src/lib/index.js"
    },
    "./theme": {
      "types": "./src/theme.d.ts",
      "import": "./src/theme.js",
      "default": "./src/theme.js"
    },
    "./theme.css": "./src/styles/theme.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.svelte",
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ./scripts/build.mjs",
    "check:types": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:pack": "node ./scripts/check-pack.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm check:types && pnpm test && pnpm build && pnpm check:pack",
    "prepare": "node ./scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "shadcn-svelte": "^1.7.2",
    "svelte": "5.57.3",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": false
    }
  },
  "dependencies": {
    "@icons-pack/svelte-simple-icons": "^7.2.0",
    "@lucide/svelte": "^1.66.0",
    "bits-ui": "^2.20.2",
    "cn": "^0.5.0",
    "tailwind-variants": "^3.3.1"
  },
  "packageManager": "pnpm@12.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/weluvabid/iris.git"
  }
}
