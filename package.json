{
  "name": "@weluvabid/iris",
  "version": "0.2.0",
  "description": "A minimal visual foundation and reusable site shell for independent OSS projects.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "files": [
    "iris.css",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./iris.css",
    "./components": {
      "types": "./src/lib/index.d.ts",
      "svelte": "./src/lib/index.js",
      "default": "./src/lib/index.js"
    },
    "./theme": {
      "types": "./src/theme.d.ts",
      "import": "./src/theme.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "**/*.svelte"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "node ./scripts/build.mjs",
    "check:types": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:pack": "node ./scripts/check-pack.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm check:types && pnpm test && pnpm build && pnpm check:pack",
    "prepare": "node ./scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.0.0",
    "eslint": "9.39.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.7.2",
    "svelte": "5.38.0",
    "svelte-check": "4.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.0.0",
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
