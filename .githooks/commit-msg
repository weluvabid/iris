#!/bin/sh
set -eu
MESSAGE_FILE=${1:?commit message file is required}
SUBJECT=$(sed -n '1p' "$MESSAGE_FILE")

if printf '%s\n' "$SUBJECT" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  exit 0
fi

echo 'Invalid commit subject. Use Conventional Commits, e.g. feat(shell): add sticky pill.' >&2
exit 1
